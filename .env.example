# This file is an example. Copy it to .env and fill in your actual values.
# The .env file should NOT be committed to version control.

# The base URL of your OpenAI-compatible LLM service.
# For local models with OpenWebUI, this is typically http://localhost:8080/v1
# For local models with Ollama, this is typically http://localhost:11434/v1
OPENAI_BASE_URL="http://localhost:8080/v1"

# The API key for your LLM service.
# For many local models, this can be a placeholder like "ollama" or "not-needed".
OPENAI_API_KEY="your-api-key"

# (Optional) You can use this environment variable to specify the path to your
# configuration file. If not set, you must provide the path programmatically
# using `set_config_path()` or via a command-line argument.
# COGNIA_CONFIG_PATH="path/to/your/config.yaml"
