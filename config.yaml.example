# This is an example configuration file for the CogniAgents framework.
# It demonstrates all available configuration keys and their usage.

# --- Global LLM Settings ---
# These settings are inherited by all agents unless overridden.
global_llm_settings:
  model: "gemini-1.5-flash"
  temperature: 0.2
  max_tokens: 1024

# --- Defaults ---
# Default options that can be used by workflows/callers.
defaults:
  max_tokens: 2048
  language: "en"

# --- Prompt Components ---
# Reusable snippets of text that can be included in agent prompts.
# This helps keep prompts DRY (Don't Repeat Yourself).
prompt_components:
  polite_tone: "Your response must be polite, professional, and empathetic."
  json_instructions: "Ensure your output is a valid JSON object matching the required schema."

# --- Custom Schemas ---
# Register custom Pydantic models to be used as structured outputs for agents.
# The key is the short name you'll use in agent definitions.
# The value is the full Python import path: 'path.to.module:ClassName'.
custom_schemas:
  support_ticket: "your_project.schemas:SupportTicketOutput"

# --- Custom Tools ---
# Register custom Python functions to be used as tools by agents.
# The key is the short name you'll use in agent definitions.
# The value is the full Python import path: 'path.to.module:function_name'.
custom_tools:
  get_time: "your_project.tools:get_current_time"

# --- MCP (Model Context Protocol) Servers ---
# Configure connections to MCP servers that provide external toolsets.
mcp_servers:
  remote_fetcher:
    type: "streamable-http"
    url: "https://remote.mcpservers.org/fetch/mcp"

# --- Agent Definitions ---
# A list of all AI agents in the system.
agents:
  # A simple agent that uses global settings and a built-in schema.
  - name: sentiment_analyzer
    description: "Analyzes the sentiment of a given text."
    prompt: |
      Analyze the sentiment of the following text and provide a rationale.
      Text: {text_to_analyze}
    output_schema: "sentiment" # Uses the built-in 'sentiment' schema

  # An agent that overrides some global LLM settings.
  - name: creative_writer
    description: "A creative agent for brainstorming."
    prompt: "Write three taglines for a new brand of coffee. Details: {details}"
    llm:
      model: "gemini-1.5-pro" # Overrides the global model
      temperature: 0.9      # Overrides the global temperature
    output_schema: "str" # Uses the built-in 'str' schema for a simple string output

  # An agent that uses a custom schema and a prompt component.
  - name: ticket_classifier
    description: "Classifies a support ticket and assigns priority."
    prompt: |
      Classify the following support ticket.
      {{ prompt_components.polite_tone }}
      {{ prompt_components.json_instructions }}
      Ticket: {ticket_text}
    output_schema: "support_ticket" # Uses the custom schema defined above

  # An agent that uses a local custom tool.
  - name: time_agent
    description: "An agent that can retrieve the current time."
    prompt: "What is the current time?"
    tools:
      - get_time # Uses the custom tool defined in 'custom_tools'
    output_schema: "str"

  # An agent that uses an MCP toolset.
  - name: fetcher_agent
    description: "An agent that can use tools from an MCP server."
    prompt: "Fetch the content of {url}"
    toolsets:
      - remote_fetcher # Uses the MCP server defined in 'mcp_servers'
    output_schema: "str"
